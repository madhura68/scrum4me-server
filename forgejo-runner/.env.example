# forgejo-runner/.env.example
# Uitsluitend imagepins en niet-geheime waarden. Nooit tokens of UUID's.
# Runner en DinD: de RepoDigests uit evidence/stap-a/scrum4me-server/images.json,
# dat is wat er aantoonbaar draait (Runner v12.10.1). De registry-tag runner:12
# wijst inmiddels naar v12.13.2 (evidence/stap-a/resolved-digests.tsv); daarom
# nooit een tag maar altijd deze digest.
# Jobimage: registry-geresolveerde index-digest van catthehacker/ubuntu:act-latest (§7.4).
RUNNER_IMAGE=code.forgejo.org/forgejo/runner@sha256:3d49075f9115054ae2485d8cea2819296a904dfd4f00017285168028615d8533
DIND_IMAGE=docker@sha256:685b91dca8eab7de1dce1c303dbb7a763e4082d6a60db10968adf3295fbd2495
JOB_IMAGE=catthehacker/ubuntu@sha256:c58e2b364da03b0c804c7d660f2ecbedf2f221a382b9baa0b344b0144780ff43

# Resourcecaps, mechanisch overgenomen uit evidence/stap-a/caps.env (Task 9).
RUNNER_PIDS=256
DIND_PIDS=2048
RUNNER_CPUS=1.0
RUNNER_MEM=1073741824
DIND_CPUS=11.5
DIND_MEM=5368709120
