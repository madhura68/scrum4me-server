#!/usr/bin/env python3
"""Roteer een DB-credential zonder dat het secret in argv, logs of uitvoer belandt.

Secrets komen uitsluitend via stdin binnen en verschijnen nooit in de uitvoer.
Zie docs/runbooks/credential-rotation.md.
"""
import argparse
import base64
import datetime
import hashlib
import hmac
import os
import re
import subprocess
import sys
import tempfile
import urllib.parse

SECRET_RE = re.compile(r"\A[0-9a-f]{64}\Z")
ROLE_RE = re.compile(r"\A[a-z_][a-z0-9_]*\Z")


class Refusal(Exception):
    """Fout met een melding die gegarandeerd geen secret bevat."""


def validate_role(role):
    if not ROLE_RE.match(role):
        raise Refusal("ongeldige rolnaam")
    return role


def role_pattern(role):
    # exact op '://<role>:' zodat 'scrum4me' niet matcht in 'scrum4me_web_runtime'
    return re.compile(r"(://" + re.escape(role) + r":)([^@\s/\"']+)(@)")


def read_secret(stream):
    data = stream.read()
    if data.endswith("\r\n"):
        data = data[:-2]
    elif data.endswith("\n"):
        data = data[:-1]
    if not SECRET_RE.match(data):
        raise Refusal("invalid secret on stdin")
    return data


def dsn_pattern(role):
    return re.compile(
        r"postgres(?:ql)?://" + re.escape(role) + r":([^@\s/\"']+)@([^/\s\"'?:]+)(?::(\d+))?/([^?\s\"']+)")


def parse_dsn(text, role):
    m = dsn_pattern(role).search(text)
    if not m:
        raise Refusal(f"geen DSN voor rol {role} gevonden")
    return {
        "host": m.group(2),
        "port": m.group(3) or "5432",
        "user": role,
        "password": urllib.parse.unquote(m.group(1)),
        "dbname": m.group(4),
    }


def scram_verifier(password, salt, iterations=4096):
    # formaat van Postgres' pg_authid.rolpassword; hex-wachtwoorden zijn ASCII, SASLprep is dan een no-op
    salted = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, iterations)
    client_key = hmac.new(salted, b"Client Key", "sha256").digest()
    stored_key = hashlib.sha256(client_key).digest()
    server_key = hmac.new(salted, b"Server Key", "sha256").digest()

    def b64(b):
        return base64.b64encode(b).decode()
    return f"SCRAM-SHA-256${iterations}:{b64(salt)}${b64(stored_key)}:{b64(server_key)}"


def utc_stamp():
    # microseconden: twee runs in dezelfde seconde mogen niet op elkaars back-up botsen
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S_%fZ")


def _reason(exc):
    # alleen type en strerror: nooit str(exc) van onbekende herkomst
    return f"{type(exc).__name__}: {getattr(exc, 'strerror', None) or 'fout'}"


def _fsync_dir(path):
    try:
        fd = os.open(os.path.dirname(os.path.abspath(path)) or ".", os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def _chown_like(fd, uid, gid):
    st = os.fstat(fd)
    if (st.st_uid, st.st_gid) != (uid, gid):
        os.fchown(fd, uid, gid)


def _write_backup(path, data, st, stamp):
    bak = f"{path}.bak-{stamp}"
    fd = os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.fchmod(fd, 0o600)
        _chown_like(fd, st.st_uid, st.st_gid)
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    return bak


def _atomic_write(path, data, mode, uid, gid, expect_stat=None):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)), prefix=".rec-")
    try:
        try:
            os.fchmod(fd, mode)
            _chown_like(fd, uid, gid)
            os.write(fd, data)
            os.fsync(fd)
        finally:
            os.close(fd)
        if expect_stat is not None:
            now = os.stat(path)
            if (now.st_mtime_ns, now.st_size, now.st_ino) != (
                expect_stat.st_mtime_ns, expect_stat.st_size, expect_stat.st_ino):
                raise Refusal("bestand gewijzigd tijdens schrijven")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    _fsync_dir(path)


def _mode(st):
    return st.st_mode & 0o7777


def cmd_rewrite(args, stdin, out, err):
    pat = role_pattern(validate_role(args.role))
    plans, bad = [], False
    for path in args.file:
        try:
            st = os.stat(path)
            with open(path, "rb") as f:
                data = f.read()
            text = data.decode("utf-8")
        except (OSError, UnicodeDecodeError) as e:
            err.write(f"FAIL {path}: niet leesbaar ({_reason(e)})\n")
            bad = True
            continue
        n = len(pat.findall(text))
        if n == 0:
            err.write(f"FAIL {path}: 0 treffers voor rol {args.role}\n")
            bad = True
            continue
        plans.append((path, data, text, st, n))
    if bad:
        return 1
    if args.dry_run:
        for path, _, _, st, n in plans:
            out.write(f"dry {path} treffers={n} mode={_mode(st):o}\n")
        return 0

    secret = read_secret(stdin)
    stamp = utc_stamp()
    done = []
    for path, data, text, st, n in plans:
        new = pat.sub(lambda m: m.group(1) + secret + m.group(3), text).encode("utf-8")
        try:
            _write_backup(path, data, st, stamp)
            _atomic_write(path, new, _mode(st), st.st_uid, st.st_gid, expect_stat=st)
        except (OSError, Refusal) as e:
            reason = str(e) if isinstance(e, Refusal) else _reason(e)
            restored = _restore(done, stamp, err)
            err.write(f"FAIL {path}: {reason}; teruggezet: {restored}; stamp={stamp}\n")
            return 1
        done.append(path)
        out.write(f"ok {path} vervangen={n} mode={_mode(st):o}\n")
        if _mode(st) & ~0o640:
            out.write(f"WARN {path} mode {_mode(st):o} ruimer dan 640\n")
    out.write(f"stamp={stamp}\n")
    return 0


def _restore(paths, stamp, err):
    restored = 0
    for path in paths:
        try:
            _restore_one(path, stamp)
            restored += 1
        except OSError as e:
            err.write(f"FAIL terugzetten {path}: {_reason(e)}\n")
    return restored


def _restore_one(path, stamp):
    bak = f"{path}.bak-{stamp}"
    with open(bak, "rb") as f:
        data = f.read()
    if os.path.exists(path):
        st = os.stat(path)
        mode, uid, gid = _mode(st), st.st_uid, st.st_gid
    else:
        st = os.stat(bak)
        mode, uid, gid = 0o600, st.st_uid, st.st_gid
    _atomic_write(path, data, mode, uid, gid)


def cmd_rollback(args, stdin, out, err):
    missing = [p for p in args.file if not os.path.exists(f"{p}.bak-{args.stamp}")]
    if missing:
        for p in missing:
            err.write(f"FAIL {p}: back-up {p}.bak-{args.stamp} ontbreekt\n")
        return 1
    for path in args.file:
        try:
            _restore_one(path, args.stamp)
        except OSError as e:
            err.write(f"FAIL {path}: {_reason(e)}\n")
            return 1
        out.write(f"ok teruggezet {path}\n")
    return 0


def _first_line_without_secrets(text):
    for line in text.splitlines():
        line = line.strip()
        if line and "SCRAM-SHA-256" not in line:
            return line
    return "onbekende fout"


def cmd_alter_role(args, stdin, out, err):
    role = validate_role(args.role)
    secret = read_secret(stdin)
    verifier = scram_verifier(secret, os.urandom(16))
    sql = (
        "DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '" + role + "') "
        "THEN RAISE EXCEPTION 'role missing'; END IF; END $$;\n"
        'ALTER ROLE "' + role + "\" PASSWORD '" + verifier + "';\n"
    )
    t_alter = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    res = subprocess.run(
        ["docker", "exec", "-i", args.container, "psql", "-U", args.db_user, "-d", args.db_name,
         "-v", "ON_ERROR_STOP=1", "-tA"],
        input=sql, capture_output=True, text=True)
    if res.returncode != 0:
        err.write(f"FAIL alter-role {role}: {_first_line_without_secrets(res.stderr)}\n")
        return 1
    out.write(f"ok alter-role {role} T_alter={t_alter}\n")
    return 0


def _classify(res):
    text = (res.stderr or "") + (res.stdout or "")
    if "password authentication failed" in text:
        return "auth"
    if re.search(r"could not connect|Connection refused|timeout expired|could not translate host|No route", text):
        return "netwerk"
    return "anders"


def cmd_probe(args, stdin, out, err):
    role = validate_role(args.role)
    with open(args.file, encoding="utf-8") as f:
        dsn = parse_dsn(f.read(), role)
    fd, envfile = tempfile.mkstemp(prefix="rec-probe-")
    try:
        os.fchmod(fd, 0o600)
        body = "".join(f"{k}={v}\n" for k, v in (
            ("PGHOST", dsn["host"]), ("PGPORT", dsn["port"]), ("PGUSER", dsn["user"]),
            ("PGPASSWORD", dsn["password"]), ("PGDATABASE", dsn["dbname"]), ("PGCONNECT_TIMEOUT", "5")))
        os.write(fd, body.encode())
        os.close(fd)
        fd = None
        res = subprocess.run(
            ["docker", "run", "--rm", "--pull", "never", "--network", "host", "--env-file", envfile,
             args.image, "psql", "-tAc", "select 1"],
            capture_output=True, text=True)
    finally:
        if fd is not None:
            os.close(fd)
        os.unlink(envfile)
    target = f"{dsn['host']}:{dsn['port']}"
    if args.expect == "ok":
        if res.returncode == 0 and res.stdout.strip() == "1":
            out.write(f"ok probe {role}@{target} login geslaagd\n")
            return 0
    elif res.returncode != 0 and _classify(res) == "auth":
        out.write(f"ok probe {role}@{target} geweigerd zoals verwacht\n")
        return 0
    got = "geslaagd" if res.returncode == 0 else _classify(res)
    err.write(f"FAIL probe {role}@{target}: verwacht {args.expect}, kreeg {got}\n")
    return 1


PLACEHOLDER_CHARS = set("<>*[]^$ ")
BACKUP_RE = re.compile(r"\.bak-\d{8}T\d{6}(?:_\d{6})?Z\Z")


def scan_pattern(role):
    # ruimer dan role_pattern: ook niet-hex residu en regex/placeholder-tekst vinden
    return re.compile(r"(?<![A-Za-z0-9_])" + re.escape(role) + r":([^@\s]+)@")


def _walk(paths):
    for top in paths:
        if os.path.isfile(top) and not os.path.islink(top):
            yield top
            continue
        for root, dirs, files in os.walk(top, followlinks=False):
            for name in sorted(files):
                path = os.path.join(root, name)
                if not os.path.islink(path):
                    yield path


def cmd_scan(args, stdin, out, err):
    pat = scan_pattern(validate_role(args.role))
    current = read_secret(stdin)
    bad = 0
    for path in _walk(args.path):
        try:
            with open(path, "rb") as f:
                if b"\0" in f.read(8192):
                    continue
                f.seek(0)
                lines = f.read().decode("utf-8", errors="replace").splitlines()
        except OSError:
            out.write(f"SKIP {path}: geen toegang\n")
            continue
        backup = bool(BACKUP_RE.search(path))
        for no, line in enumerate(lines, 1):
            for m in pat.finditer(line):
                value = m.group(1)
                if value == current:
                    cls = "huidig"
                elif PLACEHOLDER_CHARS & set(value):
                    cls = "placeholder/regex"
                else:
                    cls = "ANDERS"
                    if not backup:
                        bad += 1
                out.write(f"{path}:{no} {cls}{' (backup)' if backup else ''}\n")
    return 1 if bad else 0


def build_parser():
    p = argparse.ArgumentParser(prog="rotate-env-credential", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("rewrite", help="vervang het wachtwoord van ROLE in bestanden (secret via stdin)")
    r.add_argument("--role", required=True)
    r.add_argument("--file", action="append", required=True)
    r.add_argument("--dry-run", action="store_true")
    r.set_defaults(func=cmd_rewrite)
    b = sub.add_parser("rollback", help="zet back-ups van een stempel terug")
    b.add_argument("--stamp", required=True)
    b.add_argument("--file", action="append", required=True)
    b.set_defaults(func=cmd_rollback)
    a = sub.add_parser("alter-role", help="zet het wachtwoord van ROLE als SCRAM-verifier (secret via stdin)")
    a.add_argument("--role", required=True)
    a.add_argument("--container", default="scrum4me-postgres")
    a.add_argument("--db-user", default="scrum4me")
    a.add_argument("--db-name", default="scrum4me")
    a.set_defaults(func=cmd_alter_role)
    pr = sub.add_parser("probe", help="probeer in te loggen met de DSN van ROLE uit FILE")
    pr.add_argument("--role", required=True)
    pr.add_argument("--file", required=True)
    pr.add_argument("--expect", choices=["ok", "reject"], required=True)
    pr.add_argument("--image", default="postgres:17")
    pr.set_defaults(func=cmd_probe)
    sc = sub.add_parser("scan", help="zoek residu van ROLE-credentials (huidig secret via stdin)")
    sc.add_argument("--role", required=True)
    sc.add_argument("path", nargs="+")
    sc.set_defaults(func=cmd_scan)
    return p


def main(argv, stdin=sys.stdin, out=sys.stdout, err=sys.stderr):
    args = build_parser().parse_args(argv)
    try:
        return args.func(args, stdin, out, err)
    except Refusal as e:
        err.write(f"FAIL {e}\n")
        return 2
    except OSError as e:
        err.write(f"FAIL {getattr(e, 'filename', '') or ''}: {_reason(e)}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
